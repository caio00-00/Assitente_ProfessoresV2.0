# Canal Educação v4 — modelo de variáveis de ambiente.
# Copie para .env e preencha. NUNCA versione o .env.
# No Dokploy, cadastre estas mesmas variáveis na aba Environment do serviço.

# --- Ambiente -------------------------------------------------------------
# local | hml | production. Em production: SECRET_KEY padrão é recusada e /docs fica desligado.
ENVIRONMENT=local
DEBUG=false
DOCS_ENABLED=true
APP_DOMAIN=http://localhost:8000/

# --- Banco (Postgres local do docker-compose.yml) ------------------------
POSTGRES_USER=assistente_professores
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=canal_local
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Porta do Postgres local exposta só em 127.0.0.1 (para DBeaver/pgAdmin)
POSTGRES_PORT_LOCAL=5432
# Versão da imagem do Postgres local (use a mesma do banco de HML para restaurar o dump)
POSTGRES_VERSION=15

# --- Banco no Supabase (docker-compose.supabase.yml) ----------------------
# Quando definida, DATABASE_URL tem prioridade sobre as POSTGRES_* acima.
# Use o "Session pooler" (porta 5432) com sslmode=require.
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Redis / Celery -------------------------------------------------------
REDIS_PASSWORD=redis_local
# No compose o REDIS_URL é montado a partir de REDIS_PASSWORD.
# REDIS_URL=redis://:redis_local@redis:6379/0

# --- Segurança ------------------------------------------------------------
# Gere uma chave nova:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque_por_uma_chave_longa_e_aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# --- Banco: preparação na subida -----------------------------------------
# 1 = o entrypoint roda scripts/db_bootstrap.py antes da API (padrão)
RUN_MIGRATIONS=1
# true = comportamento da v3 (create_all a cada subida, sem o entrypoint novo)
AUTO_CREATE_TABLES=false

# --- Compliance (Google Drive) -------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GOOGLE_DRIVE_VIDEOS_FOLDER_ID=id_pendente
GOOGLE_DRIVE_PDFS_FOLDER_ID=id_pendente
GOOGLE_DRIVE_RESTRINGIR_PASTAS=true
COMPLIANCE_INITIAL_DELAY_SECONDS=9000
COMPLIANCE_RETRY_INTERVAL_SECONDS=900
COMPLIANCE_MAX_RETRIES=20
COMPLIANCE_MAX_AGE_DAYS=45
COMPLIANCE_MIN_VIDEO_MB=100
CELERY_VISIBILITY_TIMEOUT_SECONDS=43200

# --- E-mail (convites e recuperação de senha) -----------------------------
# Sem SMTP_USER/SMTP_PASSWORD o link é só registrado no log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@oroseducacao.page
SMTP_USE_TLS=true
ALLOWED_EMAIL_DOMAINS=
CORS_ORIGINS=http://localhost:8000

# --- API externa (Vimeo Sync, Estudologia) --------------------------------
EXTERNAL_API_KEY=troque_esta_chave

# --- Gunicorn (modo "api") -----------------------------------------------
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120

# ─── Rodar ao lado de outra cópia do sistema no mesmo computador ───
# Os nomes dos containers e as portas precisam ser diferentes dos da outra cópia.
# CONTAINER_PREFIX=canal_v4
# API_PORT_LOCAL=8001
# POSTGRES_PORT_LOCAL=5433
# REDIS_PORT_LOCAL=6380
